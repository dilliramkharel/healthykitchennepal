{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "redirects": [
    { "source": "/essential-nepali-spices", "destination": "/blog/essential-nepali-spices", "permanent": true },
    { "source": "/traditional-nepali-drinks-for-health", "destination": "/blog/traditional-nepali-drinks-for-health", "permanent": true },
    { "source": "/moringa-benefits", "destination": "/blog/moringa-benefits", "permanent": true },
    { "source": "/homemade-lito-for-babies", "destination": "/blog/homemade-lito-for-babies", "permanent": true },
    { "source": "/healthy-food-in-nepal", "destination": "/blog/healthy-food-in-nepal", "permanent": true },
    { "source": "/health-benefits-of-flax-seeds", "destination": "/blog/health-benefits-of-flax-seeds", "permanent": true },
    { "source": "/healthy-fruits", "destination": "/blog/healthy-fruits", "permanent": true },
    { "source": "/10-best-healthy-breakfast-ideas-for-a-energetic-day", "destination": "/blog/10-best-healthy-breakfast-ideas-for-a-energetic-day", "permanent": true },
    { "source": "/organic-farming-benefits", "destination": "/blog/organic-farming-benefits", "permanent": true },
    { "source": "/health-benefits-of-drinking-lemon-water", "destination": "/blog/health-benefits-of-drinking-lemon-water", "permanent": true },
    { "source": "/traditional-nepali-food-for-weight-loss", "destination": "/blog/traditional-nepali-food-for-weight-loss", "permanent": true },
    { "source": "/category/organic-farming", "destination": "/guides/organic-farming-farm-to-thali", "permanent": true },
    { "source": "/नेपालका-सुपरफुडहरू-जौ-र-क", "destination": "/guides/weight-loss-barley-millet", "permanent": true },
    { "source": "/nepali-kitchen-detox-guide", "destination": "/blog/nepali-kitchen-detox-guide", "permanent": true },
    {
      "source": "/wp-admin",
      "destination": "https://cms.healthykitchennepal.xyz/wp-admin",
      "permanent": false
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "https://cms.healthykitchennepal.xyz/wp-admin/:path*",
      "permanent": false
    },
    {
      "source": "/wp-login.php",
      "destination": "https://cms.healthykitchennepal.xyz/wp-login.php",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/wp-content/:path*",
      "destination": "https://cms.healthykitchennepal.xyz/wp-content/:path*"
    },
    {
      "source": "/wp-includes/:path*",
      "destination": "https://cms.healthykitchennepal.xyz/wp-includes/:path*"
    },
    {
      "source": "/wp-json/:path*",
      "destination": "https://cms.healthykitchennepal.xyz/wp-json/:path*"
    }
  ]
}
